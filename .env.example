# RazorGuard AI Environment Configuration Template
# Copy this file to .env and provide your API keys for live AI investigation agent execution.

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database (Default: SQLite in ./data/razorguard.db)
DATABASE_URL=sqlite:///./data/razorguard.db

# AI Agent Configuration (Track 2: AI Risk Manager)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AGENT_MODEL_NAME=gemini-2.5-flash
AGENT_TEMPERATURE=0.1
AGENT_TIMEOUT_SECONDS=8.0
AGENT_FALLBACK_DETERMINISTIC=True

# Optional: OpenAI Provider
OPENAI_API_KEY=your_openai_api_key_here
